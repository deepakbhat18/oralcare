# ==============================================================================
# ORALCARE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# NEVER COMMIT .env TO GIT!
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/dental_clinic
DB_USER=dental_user
DB_PASS=dental_pass

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security
# Generate a strong 256-bit or 512-bit Base64-encoded secret for production
# Example generation: openssl rand -base64 64
JWT_SECRET=your-base64-encoded-secret

# Mail Configuration (e.g. Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-16-char-app-password
NOTIFICATION_FROM=noreply@dentalclinic.com

# Google OAuth2 Login (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Storage
FILE_UPLOAD_DIR=./uploads
